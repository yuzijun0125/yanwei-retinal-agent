ARG PYTHON_BASE=docker.m.daocloud.io/library/python:3.11-slim
FROM ${PYTHON_BASE}
WORKDIR /app
COPY integration /app/integration
COPY 02_代码/web /app/02_代码/web
COPY 02_代码/yanwei /app/02_代码/yanwei
ENV PYTHONUTF8=1 PYTHONUNBUFFERED=1
EXPOSE 18880
CMD ["python", "integration/gateway.py", "--host", "0.0.0.0", "--port", "18880"]
