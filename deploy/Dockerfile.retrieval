ARG PYTHON_BASE=docker.m.daocloud.io/library/python:3.11-slim
FROM ${PYTHON_BASE}
WORKDIR /app
RUN python -m pip install --no-cache-dir torch==2.6.0+cpu torchvision==0.21.0+cpu --index-url https://download.pytorch.org/whl/cpu
COPY deploy/requirements-linux.txt /tmp/requirements-linux.txt
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
RUN python -m pip install --no-cache-dir --index-url ${PIP_INDEX_URL} -r /tmp/requirements-linux.txt
COPY integration/vendor /opt/vendor
COPY 02_代码 /app/02_代码
ENV PYTHONPATH=/opt/vendor:/app/02_代码 PYTHONUTF8=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
EXPOSE 8235
CMD ["python", "02_代码/run_demo.py", "--host", "0.0.0.0", "--port", "8235", "--no-browser"]
